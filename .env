# --- Required -----------------------------------------------------------

# OpenAI powers both generation and embeddings.
OPENAI_API_KEY=sk-proj...

# --- Optional overrides (defaults shown) --------------------------------

# Changing CHAT_MODEL changes the model used for reasoning/tool calling.
# CHAT_MODEL=gpt-4.1-mini


# Changing EMBEDDING_MODEL requires rebuilding the vector store:
#   python -m src.ingest --reset
# EMBEDDING_MODEL=text-embedding-3-small

